# Google Cloud API key used by the Stitch MCP server (.mcp.json)
# Create one at https://console.cloud.google.com/apis/credentials
GCP_API_KEY=

# Public site URL — used for SEO (canonical, sitemap, Open Graph, JSON-LD).
# Set to your real domain in production, e.g. https://www.yourdomain.org
NEXT_PUBLIC_SITE_URL=
