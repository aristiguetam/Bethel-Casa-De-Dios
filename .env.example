# Google Cloud API key used by the Stitch MCP server (.mcp.json)
# Create one at https://console.cloud.google.com/apis/credentials
GCP_API_KEY=

# Public site URL — used for SEO (canonical, sitemap, Open Graph, JSON-LD).
#
# Leave EMPTY until the real domain is confirmed. While it is empty the site
# still works, but robots.txt disallows everything and every page is noindex,
# so Vercel deploys can't get indexed under a throwaway .vercel.app URL.
# Setting it is what turns SEO on: e.g. https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=
